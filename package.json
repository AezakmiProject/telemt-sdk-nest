{
  "name": "@aezakmiproject/telemt-sdk-nest",
  "version": "1.0.0",
  "description": "NestJS module for the Telemt MTProto proxy Control API: injectable typed client, sync and async registration, no-throw responses, Node 22+",
  "homepage": "https://github.com/AezakmiProject/telemt-sdk-nest#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AezakmiProject/telemt-sdk-nest.git"
  },
  "bugs": {
    "url": "https://github.com/AezakmiProject/telemt-sdk-nest/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "keywords": [
    "telemt",
    "telemt-sdk",
    "nestjs",
    "nest",
    "nestjs-module",
    "nestjs-library",
    "nestjs-sdk",
    "mtproto",
    "mtproto-proxy",
    "telegram",
    "telegram-proxy",
    "proxy",
    "proxy-server",
    "typescript",
    "typescript-sdk",
    "sdk",
    "api-client",
    "rest-client",
    "dependency-injection",
    "dynamic-module",
    "node",
    "aezakmi"
  ],
  "author": "ABRAMOVI4CH",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@aezakmiproject/telemt-sdk": "^1.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@aezakmiproject/telemt-sdk": "^1.2.0",
    "@nestjs/common": "^12.0.0",
    "reflect-metadata": "^0.2.0"
  }
}
