{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The base config's `moduleResolution: node10` was removed in TS 7. These
    // mirror how vitest actually resolves at test time, and are scoped to
    // typechecking only so the published build output is unaffected.
    "moduleResolution": "bundler",
    "module": "preserve",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.mts", "vitest.setup.mts"],
  "exclude": ["node_modules", "dist"]
}
